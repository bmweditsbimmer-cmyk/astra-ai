# Copy this file to .env and set your own secrets before publishing.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-before-publishing
# OpenAI-compatible chat completions API. Keep keys server-side only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: set NODE_ENV=production when deployed behind HTTPS.
NODE_ENV=development
